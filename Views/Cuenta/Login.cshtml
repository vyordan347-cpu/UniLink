@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="ul-auth-page" aria-labelledby="titulo-login">
    <img class="ul-hero-foto" src="~/img/campus/campus-edificio.webp.png" alt="" aria-hidden="true"
         width="814" height="668" loading="eager" fetchpriority="high" />
    <div class="ul-auth-card ul-glass">
        <a class="ul-auth-brand" asp-controller="Home" asp-action="Index" aria-label="UniLink, ir al inicio">
            <img src="~/img/unilink-mark.svg" width="48" height="48" alt="" />
            <span>UniLink</span>
        </a>
        <p class="ul-auth-subtitle">Comunidad estudiantil USMP</p>
        <h1 id="titulo-login">Bienvenido de vuelta</h1>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="ul-auth-validation mb-3"></div>
            <div class="ul-auth-field">
                <label asp-for="Correo" class="form-label">Correo institucional</label>
                <div class="ul-auth-control">
                    <svg class="ul-auth-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m4 7 8 6 8-6" />
                    </svg>
                    <input asp-for="Correo" class="form-control ul-glass-input" autocomplete="username" />
                </div>
                <span asp-validation-for="Correo" class="ul-auth-validation"></span>
            </div>
            <div class="ul-auth-field">
                <label asp-for="Contraseña" class="form-label"></label>
                <div class="ul-auth-control">
                    <svg class="ul-auth-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <rect x="4" y="10" width="16" height="11" rx="2" />
                        <path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2" />
                    </svg>
                    <input asp-for="Contraseña" class="form-control ul-glass-input" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Contraseña" class="ul-auth-validation"></span>
            </div>
            <div class="ul-auth-options">
                <div class="form-check">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label">Recordarme</label>
                </div>
                <a class="ul-auth-link" href="#">¿Olvidaste tu contraseña?</a>
            </div>
            <button type="submit" class="btn btn-action ul-glass-button w-100">Iniciar sesión</button>
        </form>
        <p class="ul-auth-switch">¿No tienes cuenta? <a asp-action="Registro">Regístrate</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
