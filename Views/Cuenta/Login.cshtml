@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="container form-page">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="form-card">
                <p class="eyebrow mb-2">Qué bueno tenerte de vuelta</p>
                <h1 class="mb-4">Iniciar sesión</h1>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label">Correo institucional</label>
                        <input asp-for="Correo" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Contraseña" class="form-label"></label>
                        <input asp-for="Contraseña" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Contraseña" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label">Recordarme</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
                </form>
                <p class="text-center mt-4 mb-0">¿No tienes cuenta? <a asp-action="Registro">Crear cuenta</a></p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
