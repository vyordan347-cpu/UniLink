@model ClaseViewModel

<form asp-action="@(Model.Id == 0 ? "Ofrecer" : "Editar")"
      asp-route-id="@(Model.Id == 0 ? null : Model.Id)"
      method="post" class="card formulario-clase" data-oferta-clase>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Curso" class="form-label">Curso</label>
            <input asp-for="Curso" class="form-control" placeholder="Ej. Anatomía I" />
            <span asp-validation-for="Curso" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Modalidad" class="form-label">Modalidad</label>
            <select asp-for="Modalidad" class="form-select">
                <option value="@ModalidadClase.VideollamadaUniLink">Videollamada UniLink (Jitsi)</option>
                <option value="@ModalidadClase.GoogleMeet">Google Meet</option>
                <option value="@ModalidadClase.Zoom">Zoom</option>
            </select>
            <span asp-validation-for="Modalidad" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="EsSolidaria" class="form-check-input" data-clase-solidaria />
            <label asp-for="EsSolidaria" class="form-check-label fw-semibold">Ofrecer gratis como clase solidaria</label>
        </div>
        <div class="mb-4" data-precio-clase>
            <label asp-for="PrecioHora" class="form-label">Precio por hora</label>
            <div class="input-group">
                <span class="input-group-text">S/</span>
                <input asp-for="PrecioHora" type="number" min="0.01" step="0.01" class="form-control" />
            </div>
            <span asp-validation-for="PrecioHora" class="text-danger"></span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-action">@(Model.Id == 0 ? "Publicar clase" : "Guardar cambios")</button>
            <a class="btn btn-outline-secondary" asp-action="Mias" asp-route-pestaña="tutor">Cancelar</a>
        </div>
    </div>
</form>
