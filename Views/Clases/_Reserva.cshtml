@model (ReservaClase Reserva, bool ComoAlumno)

@{
    var reserva = Model.Reserva;
    var comoAlumno = Model.ComoAlumno;
    var fechaLocal = DateTime.SpecifyKind(reserva.FechaHora, DateTimeKind.Utc).AddHours(-5);
}

<article class="card reserva-clase mb-3">
    <div class="card-body d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
            <p class="eyebrow mb-1">@(comoAlumno ? $"Tutor: {reserva.Clase.Tutor.Nombre} · {reserva.Clase.Tutor.Carrera}" : $"Alumno: {reserva.Alumno.Nombre} · {reserva.Alumno.Carrera}")</p>
            <h3 class="h3 mb-2">@reserva.Clase.Curso</h3>
            <p class="text-secondary mb-1">
                @fechaLocal.ToString("dd/MM/yyyy HH:mm") · @reserva.DuracionHoras @(reserva.DuracionHoras == 1 ? "hora" : "horas")
            </p>
            @if (!string.IsNullOrWhiteSpace(reserva.TemaAReforzar))
            {
                <p class="mb-1">Tema a reforzar: @reserva.TemaAReforzar</p>
            }
            <p class="mb-0">Costo total: <strong>S/ @reserva.CostoTotal.ToString("0.00")</strong></p>
            @if (reserva.Estado == EstadoSolicitud.Aprobado && !string.IsNullOrWhiteSpace(reserva.EnlaceReunion))
            {
                <a class="btn btn-outline-primary mt-3" href="@reserva.EnlaceReunion" target="_blank" rel="noopener noreferrer">
                    Unirse a la clase
                </a>
            }
            @if (comoAlumno && reserva.Estado == EstadoSolicitud.Devuelto && reserva.Resena is null)
            {
                <a class="btn btn-outline-primary mt-3"
                   asp-controller="Resenas" asp-action="Clase" asp-route-id="@reserva.Id">
                    Dejar reseña
                </a>
            }
        </div>
        <div class="d-flex flex-column align-items-start align-items-lg-end gap-2">
            <span class="badge estado-badge @EstadoClaseHelper.ObtenerClaseBadge(reserva.Estado)">
                @EstadoClaseHelper.ObtenerEtiqueta(reserva.Estado)
            </span>
            @if (!comoAlumno && reserva.Estado == EstadoSolicitud.Pendiente)
            {
                <div class="d-grid gap-2 w-100">
                    <form asp-action="Aprobar" method="post" class="d-grid gap-2">
                        <input type="hidden" name="id" value="@reserva.Id" />
                        <label class="form-label mb-0" for="enlace-reunion-@reserva.Id">¿Prefieres tu propio enlace de Meet o Zoom?</label>
                        <input id="enlace-reunion-@reserva.Id" type="url" name="enlaceReunion" maxlength="500"
                               class="form-control" placeholder="Opcional: https://" />
                        <button type="submit" class="btn btn-action">Confirmar</button>
                    </form>
                    <form asp-action="Rechazar" method="post">
                        <input type="hidden" name="id" value="@reserva.Id" />
                        <button type="submit" class="btn btn-outline-danger">Rechazar</button>
                    </form>
                </div>
            }
            else if (!comoAlumno && reserva.Estado == EstadoSolicitud.Aprobado)
            {
                <form asp-action="MarcarDictada" method="post">
                    <input type="hidden" name="id" value="@reserva.Id" />
                    <button type="submit" class="btn btn-action">Marcar como dictada</button>
                </form>
            }
        </div>
    </div>
</article>
