@model ResenaCrearViewModel

<section class="container form-page">
    <div class="form-card">
        <p class="eyebrow mb-2">Tu experiencia ayuda a la comunidad</p>
        <h1 class="h2">Dejar reseña</h1>
        <p class="text-secondary mb-4">@ViewData["TituloOperacion"]</p>
        <form asp-action="@ViewContext.RouteData.Values["action"]" method="post">
            <input asp-for="OperacionId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-4">
                <label asp-for="Calificacion" class="form-label">Calificación</label>
                <select asp-for="Calificacion" class="form-select" aria-label="Calificación de 1 a 5 estrellas">
                    <option value="0">Elige una calificación</option>
                    <option value="5">★★★★★ — Excelente</option>
                    <option value="4">★★★★☆ — Muy buena</option>
                    <option value="3">★★★☆☆ — Buena</option>
                    <option value="2">★★☆☆☆ — Puede mejorar</option>
                    <option value="1">★☆☆☆☆ — Mala</option>
                </select>
                <span asp-validation-for="Calificacion" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Comentario" class="form-label">Comentario</label>
                <textarea asp-for="Comentario" class="form-control" rows="5" maxlength="500"
                          placeholder="Cuéntale a otros estudiantes cómo te fue." required></textarea>
                <span asp-validation-for="Comentario" class="text-danger"></span>
                <p class="form-text">Máximo 500 caracteres.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-action">Publicar reseña</button>
                <a asp-controller="@(ViewContext.RouteData.Values["action"]?.ToString() == "Alquiler" ? "Alquileres" : "Clases")"
                   asp-action="@(ViewContext.RouteData.Values["action"]?.ToString() == "Alquiler" ? "Index" : "Mias")"
                   class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</section>
