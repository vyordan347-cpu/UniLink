@model IReadOnlyList<UniLink.Models.Categoria>

@{
    ViewData["Title"] = "Mi panel";
}

<section class="ul-panel-resumen">
    <div class="container py-5">
        <div class="mb-5">
            <p class="ul-panel-eyebrow">Tu espacio en UniLink</p>
            <h1>Hola, @ViewData["NombreUsuario"] 👋</h1>
        </div>
        <div class="row g-4 ul-panel-estadisticas">
        <div class="col-md-4">
            <article class="card ul-glass ul-panel-stat h-100 rounded-4">
                <div class="card-body p-4">
                    <p class="mb-2">Alquileres activos</p>
                    <p class="display-5 fw-semibold mb-0">@ViewData["AlquileresActivos"]</p>
                </div>
            </article>
        </div>
        <div class="col-md-4">
            <article class="card ul-glass ul-panel-stat h-100 rounded-4">
                <div class="card-body p-4">
                    <p class="mb-2">Clases próximas</p>
                    <p class="display-5 fw-semibold mb-0">@ViewData["ClasesProximas"]</p>
                </div>
            </article>
        </div>
        <div class="col-md-4">
            <article class="card ul-glass ul-panel-stat h-100 rounded-4">
                <div class="card-body p-4">
                    <p class="mb-2">Solicitudes pendientes</p>
                    <p class="display-5 fw-semibold mb-0">@ViewData["SolicitudesPendientes"]</p>
                </div>
            </article>
        </div>
        </div>
    </div>
</section>
<section class="container py-5">
    <div class="d-flex flex-wrap gap-2 mt-4">
        <a class="btn btn-action" asp-controller="Clases" asp-action="Index">Explorar clases</a>
        <a class="btn btn-outline-secondary" asp-controller="Materiales" asp-action="Index">Explorar materiales</a>
        <a class="btn btn-outline-secondary" asp-controller="Alquileres" asp-action="Index">Mis alquileres</a>
        <a class="btn btn-outline-secondary" asp-controller="Clases" asp-action="Mias">Mis clases</a>
        <a class="btn btn-outline-secondary" asp-controller="Alquileres" asp-action="Recibidas">Solicitudes recibidas</a>
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Publicar
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Materiales" asp-action="Publicar">Publicar material</a></li>
                <li><a class="dropdown-item" asp-controller="Clases" asp-action="Ofrecer">Ofrecer clase</a></li>
            </ul>
        </div>
    </div>
    @{
        var recomendaciones = ViewData["Recomendaciones"] as IReadOnlyList<RecomendacionViewModel>
            ?? Array.Empty<RecomendacionViewModel>();
    }
    <section class="seccion-recomendaciones mt-5" aria-labelledby="titulo-recomendaciones">
        <div class="mb-4">
            <p class="text-uppercase fw-semibold text-primary mb-2">A tu medida</p>
            <h2 id="titulo-recomendaciones" class="h2 mb-2">Te puede interesar ✨</h2>
            <p class="text-secondary mb-0">Materiales y clases que podrían ayudarte en tu carrera.</p>
        </div>
        @if (recomendaciones.Count == 0)
        {
            <div class="recomendaciones-vacio">
                <p class="mb-3">Aún no encontramos opciones disponibles de tu carrera.</p>
                <a class="btn btn-outline-primary" asp-controller="Materiales" asp-action="Index">Explorar materiales</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var recomendacion in recomendaciones)
                {
                    <div class="col">
                        <article class="recomendacion-card h-100">
                            @if (recomendacion.Tipo == "Material" && !string.IsNullOrWhiteSpace(recomendacion.ImagenUrl))
                            {
                                <img class="recomendacion-imagen" src="@recomendacion.ImagenUrl" alt="@recomendacion.Titulo" loading="lazy" />
                            }
                            <div class="recomendacion-contenido">
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="recomendacion-etiqueta">Recomendado para ti</span>
                                    @if (recomendacion.EsSolidario)
                                    {
                                        <span class="badge badge-solidario">GRATUITO</span>
                                    }
                                    <span class="recomendacion-tipo">@recomendacion.Tipo</span>
                                </div>
                                <p class="text-primary fw-semibold mb-1">@recomendacion.Carrera</p>
                                <h3 class="h3">@recomendacion.Titulo</h3>
                                <p class="text-secondary recomendacion-descripcion">@recomendacion.Descripcion</p>
                                <div class="mt-auto">
                                    @if (recomendacion.EsSolidario)
                                    {
                                        <p class="precio-material precio-solidario mb-3">GRATUITO</p>
                                    }
                                    else
                                    {
                                        <p class="precio-material mb-3">S/ @recomendacion.Precio.ToString("0.00") <span>@recomendacion.UnidadPrecio</span></p>
                                    }
                                    <a class="btn btn-outline-primary w-100" href="@recomendacion.UrlDetalle">Ver detalle</a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>
    <div class="mt-5">
        <h2 class="h3 mb-3">Categorías de materiales</h2>
        @if (Model.Count == 0)
        {
            <p class="text-secondary mb-0">Las categorías estarán disponibles cuando se publiquen materiales.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var categoria in Model)
                {
                    <span class="badge rounded-pill text-bg-light border text-primary px-3 py-2">
                        @categoria.Nombre
                    </span>
                }
            </div>
        }
    </div>
</section>
