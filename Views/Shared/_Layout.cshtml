<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title && title != "Inicio" ? $"{title} | UniLink" : "UniLink")</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UniLink.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom site-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">UniLink<span>.</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto align-items-md-center gap-md-2">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Materiales" asp-action="Index">Explorar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Materiales" asp-action="Index" asp-route-soloGratuitos="true">Solidario</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Materiales" asp-action="Publicar">Publicar</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Materiales" asp-action="Mios">Mis materiales</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Alquileres" asp-action="Index">Mis alquileres</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Alquileres" asp-action="Recibidas">Solicitudes</a></li>
                            <li class="nav-item ms-md-2"><a class="nav-link nav-login" asp-controller="Panel" asp-action="Index">Mi panel</a></li>
                            <li class="nav-item">
                                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link border-0 bg-transparent">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-md-2"><a class="nav-link nav-login" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="container pt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="container pt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <span>UniLink</span> · Comunidad USMP · Conecta, comparte y aprende
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
