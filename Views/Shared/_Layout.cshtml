@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using UniLink.Data
@inject UniLinkDbContext Db
<!DOCTYPE html>
@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
    var estaAutenticado = User.Identity?.IsAuthenticated == true;
    var explorarActivo = controladorActual == "Materiales" && (accionActual == "Index" || accionActual == "Detalle")
        || controladorActual == "Clases" && (accionActual == "Index" || accionActual == "Detalle");
    var solidarioActivo = controladorActual == "Solidario";
    var actividadActiva = controladorActual == "Alquileres"
        || controladorActual == "Clases" && (accionActual == "Mias" || accionActual == "Confirmacion")
        || (controladorActual == "Materiales" && accionActual == "Mios");
    var nombreUsuario = Context.Session.GetString("NombreUsuario") ?? User.Identity?.Name;
    var inicialUsuario = !string.IsNullOrWhiteSpace(nombreUsuario)
        ? nombreUsuario[..1].ToUpperInvariant()
        : "U";
    var usuarioId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var idUsuario)
        ? idUsuario
        : (int?)null;
    var notificacionesNoLeidas = estaAutenticado && usuarioId.HasValue
        ? await Db.Notificaciones.CountAsync(notificacion =>
            notificacion.UsuarioId == usuarioId.Value && !notificacion.Leida)
        : 0;
}
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title && title != "Inicio" ? $"{title} | UniLink" : "UniLink")</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UniLink.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar site-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">UniLink<span>.</span></a>
                <div class="d-none d-md-flex ms-auto align-items-center gap-1">
                    <a class="nav-link @(explorarActivo ? "active" : "")"
                       aria-current="@(explorarActivo ? "page" : null)"
                       asp-controller="Materiales" asp-action="Index">Explorar</a>
                    <a class="nav-link @(solidarioActivo ? "active" : "")"
                       aria-current="@(solidarioActivo ? "page" : null)"
                       asp-controller="Solidario" asp-action="Index">Solidario</a>
                    @if (estaAutenticado)
                    {
                        <div class="dropdown">
                            <button class="nav-link dropdown-toggle @(actividadActiva ? "active" : "")" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                Mi actividad
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item @(controladorActual == "Alquileres" && accionActual == "Index" ? "active" : "")"
                                       asp-controller="Alquileres" asp-action="Index">Mis alquileres</a></li>
                                <li><a class="dropdown-item @(controladorActual == "Alquileres" && accionActual == "Recibidas" ? "active" : "")"
                                       asp-controller="Alquileres" asp-action="Recibidas">Solicitudes</a></li>
                                <li><a class="dropdown-item @(controladorActual == "Materiales" && accionActual == "Mios" ? "active" : "")"
                                       asp-controller="Materiales" asp-action="Mios">Mis materiales</a></li>
                                <li><a class="dropdown-item @(controladorActual == "Clases" && accionActual == "Mias" ? "active" : "")"
                                       asp-controller="Clases" asp-action="Mias">Mis clases</a></li>
                            </ul>
                        </div>
                        <a class="nav-link nav-notificaciones @(controladorActual == "Notificaciones" ? "active" : "")"
                           data-notifications-link
                           asp-controller="Notificaciones" asp-action="Index"
                           aria-label="Notificaciones, @notificacionesNoLeidas sin leer"
                           title="Notificaciones">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
                            </svg>
                            <span class="notificaciones-contador" data-notifications-count
                                  hidden="@(notificacionesNoLeidas == 0)">
                                @(notificacionesNoLeidas > 99 ? "99+" : notificacionesNoLeidas)
                            </span>
                        </a>
                        <div class="dropdown">
                            <button class="nav-link nav-publish dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Publicar
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Materiales" asp-action="Publicar">Publicar material</a></li>
                                <li><a class="dropdown-item" asp-controller="Clases" asp-action="Ofrecer">Ofrecer clase</a></li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="nav-link nav-avatar dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                    aria-expanded="false" aria-label="Abrir menú de usuario">
                                <span class="nav-avatar-inicial">@inicialUsuario</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item @(controladorActual == "Panel" ? "active" : "")"
                                       asp-controller="Panel" asp-action="Index">Mi panel</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item">Cerrar sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="nav-link @(controladorActual == "Cuenta" && accionActual == "Login" ? "active" : "")"
                           aria-current="@(controladorActual == "Cuenta" && accionActual == "Login" ? "page" : null)"
                           asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                        <a class="btn btn-primary ms-1 @(controladorActual == "Cuenta" && accionActual == "Registro" ? "active" : "")"
                           aria-current="@(controladorActual == "Cuenta" && accionActual == "Registro" ? "page" : null)"
                           asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a>
                    }
                </div>
                <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="offcanvas"
                        data-bs-target="#menuMovil" aria-controls="menuMovil" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </nav>
        <div class="offcanvas offcanvas-end site-offcanvas d-md-none" tabindex="-1" id="menuMovil" aria-labelledby="menuMovilTitulo">
            <div class="offcanvas-header">
                <h2 class="offcanvas-title navbar-brand" id="menuMovilTitulo">UniLink<span>.</span></h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar menú"></button>
            </div>
            <div class="offcanvas-body">
                <nav class="mobile-nav-links" aria-label="Navegación principal">
                    <a class="nav-link @(explorarActivo ? "active" : "")"
                       aria-current="@(explorarActivo ? "page" : null)"
                       asp-controller="Materiales" asp-action="Index">Explorar</a>
                    <a class="nav-link @(solidarioActivo ? "active" : "")"
                       aria-current="@(solidarioActivo ? "page" : null)"
                       asp-controller="Solidario" asp-action="Index">Solidario</a>
                    @if (estaAutenticado)
                    {
                        <a class="nav-link nav-notificaciones @(controladorActual == "Notificaciones" ? "active" : "")"
                           data-notifications-link
                           asp-controller="Notificaciones" asp-action="Index"
                           aria-label="Notificaciones, @notificacionesNoLeidas sin leer">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
                            </svg>
                            <span class="notificaciones-contador" data-notifications-count
                                  hidden="@(notificacionesNoLeidas == 0)">
                                @(notificacionesNoLeidas > 99 ? "99+" : notificacionesNoLeidas)
                            </span>
                        </a>
                        <div class="mobile-nav-group">
                            <p class="mobile-nav-heading">Mi actividad</p>
                            <a class="nav-link @(controladorActual == "Alquileres" && accionActual == "Index" ? "active" : "")"
                               asp-controller="Alquileres" asp-action="Index">Mis alquileres</a>
                            <a class="nav-link @(controladorActual == "Alquileres" && accionActual == "Recibidas" ? "active" : "")"
                               asp-controller="Alquileres" asp-action="Recibidas">Solicitudes</a>
                            <a class="nav-link @(controladorActual == "Materiales" && accionActual == "Mios" ? "active" : "")"
                               asp-controller="Materiales" asp-action="Mios">Mis materiales</a>
                            <a class="nav-link @(controladorActual == "Clases" && accionActual == "Mias" ? "active" : "")"
                               asp-controller="Clases" asp-action="Mias">Mis clases</a>
                        </div>
                        <div class="mobile-nav-group">
                            <p class="mobile-nav-heading">Publicar</p>
                            <a class="nav-link" asp-controller="Materiales" asp-action="Publicar">Publicar material</a>
                            <a class="nav-link" asp-controller="Clases" asp-action="Ofrecer">Ofrecer clase</a>
                        </div>
                        <a class="nav-link @(controladorActual == "Panel" ? "active" : "")"
                           asp-controller="Panel" asp-action="Index">Mi panel</a>
                        <form asp-controller="Cuenta" asp-action="Logout" method="post">
                            <button type="submit" class="nav-link w-100 text-start">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link @(controladorActual == "Cuenta" && accionActual == "Login" ? "active" : "")"
                           asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                        <a class="btn btn-primary w-100 @(controladorActual == "Cuenta" && accionActual == "Registro" ? "active" : "")"
                           aria-current="@(controladorActual == "Cuenta" && accionActual == "Registro" ? "page" : null)"
                           asp-controller="Cuenta" asp-action="Registro">Crear cuenta</a>
                    }
                </nav>
            </div>
        </div>
    </header>
    <main role="main">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="container">
                <div class="alert alert-success alert-dismissible fade show" role="alert" data-auto-dismiss>
                    @mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="container">
                <div class="alert alert-danger alert-dismissible fade show" role="alert" data-auto-dismiss>
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <span>UniLink</span> · Comunidad USMP · Conecta, comparte y aprende
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (estaAutenticado)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3" id="notificacionesToast"
             aria-live="polite" aria-atomic="false"></div>
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
        <script>
            (() => {
                const contadores = document.querySelectorAll("[data-notifications-count]");
                const enlacesNotificaciones = document.querySelectorAll("[data-notifications-link]");
                const contenedorToast = document.getElementById("notificacionesToast");

                const actualizarContador = (cantidad) => {
                    contadores.forEach((contador) => {
                        contador.textContent = cantidad > 99 ? "99+" : String(cantidad);
                        contador.hidden = cantidad < 1;
                    });
                    enlacesNotificaciones.forEach((enlace) => {
                        enlace.setAttribute("aria-label", `Notificaciones, ${cantidad} sin leer`);
                    });
                };

                const mostrarToast = (notificacion) => {
                    const toast = document.createElement("div");
                    toast.className = "toast notificacion-toast";
                    toast.setAttribute("role", "status");
                    toast.setAttribute("aria-live", "polite");
                    toast.setAttribute("aria-atomic", "true");

                    const encabezado = document.createElement("div");
                    encabezado.className = "toast-header";
                    const titulo = document.createElement("strong");
                    titulo.className = "me-auto";
                    titulo.textContent = "Nueva notificación";
                    const cerrar = document.createElement("button");
                    cerrar.type = "button";
                    cerrar.className = "btn-close";
                    cerrar.setAttribute("data-bs-dismiss", "toast");
                    cerrar.setAttribute("aria-label", "Cerrar");
                    encabezado.append(titulo, cerrar);

                    const cuerpo = document.createElement("div");
                    cuerpo.className = "toast-body";
                    const mensaje = document.createElement("p");
                    mensaje.className = "mb-2";
                    mensaje.textContent = notificacion.mensaje;
                    const enlace = document.createElement("a");
                    enlace.href = `/Notificaciones/Abrir?id=${encodeURIComponent(notificacion.id)}`;
                    enlace.textContent = "Ver notificación";
                    cuerpo.append(mensaje, enlace);
                    toast.append(encabezado, cuerpo);
                    contenedorToast.append(toast);

                    const instancia = new bootstrap.Toast(toast, { delay: 8000 });
                    toast.addEventListener("hidden.bs.toast", () => toast.remove(), { once: true });
                    instancia.show();
                };

                const conexion = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/notificaciones")
                    .withAutomaticReconnect()
                    .build();

                conexion.on("RecibirNotificacion", (notificacion) => {
                    actualizarContador(
                        Number(contadores[0]?.textContent.replace("+", "") || 0) + 1);
                    mostrarToast(notificacion);
                });

                conexion.start().catch((error) =>
                    console.error("No se pudo iniciar la conexión de notificaciones.", error));
            })();
        </script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll("[data-auto-dismiss]").forEach((alerta) => {
            window.setTimeout(() => bootstrap.Alert.getOrCreateInstance(alerta).close(), 5000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
