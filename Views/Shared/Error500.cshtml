@model ErrorViewModel

@{
    ViewData["Title"] = "Ocurrió un error";
}

<section class="container error-page">
    <article class="card error-card text-center">
        <div class="card-body">
            <p class="eyebrow mb-2">Error 500</p>
            <h1 class="h2">Tuvimos un problema</h1>
            <p class="text-secondary mb-4">No pudimos completar tu solicitud. Inténtalo nuevamente en unos minutos.</p>
            @if (Model.ShowRequestId)
            {
                <p class="text-secondary small">Referencia: <code>@Model.RequestId</code></p>
            }
            <a class="btn btn-action" asp-controller="Home" asp-action="Index">Volver al inicio</a>
        </div>
    </article>
</section>
