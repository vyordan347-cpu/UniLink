@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-section">
    <div class="container hero-grid">
        <div class="hero-copy">
            <p class="eyebrow"><span></span> Comunidad estudiantil USMP</p>
            <h1>UniLink</h1>
            <p class="hero-tagline">Conecta, comparte y aprende.</p>
            <p class="hero-description">En Odontología y Medicina, muchos materiales cuestan cientos de soles y a veces solo se usan un ciclo. UniLink te conecta con estudiantes que pueden compartirlos o ayudarte a aprender.</p>
            <div class="hero-actions">
                <a class="btn btn-action" href="#">Iniciar sesión</a>
                <a class="btn btn-outline-primary" href="#">Crear cuenta</a>
            </div>
            <p class="hero-note">Comparte materiales. Encuentra clases. Crezcan juntos.</p>
        </div>
        <div class="hero-visual" aria-label="Ejemplos de materiales y clases disponibles en UniLink">
            <div class="visual-caption">Oportunidades cerca de ti</div>
            <article class="listing listing-material">
                <div class="listing-icon material-icon" aria-hidden="true">M</div>
                <div class="listing-copy">
                    <span class="listing-type">MATERIAL · ODONTOLOGÍA</span>
                    <h2>Kit de instrumental</h2>
                    <p>Disponible para este ciclo</p>
                </div>
                <div class="listing-price"><strong>S/ 12</strong><span>por día</span></div>
            </article>
            <article class="listing listing-class">
                <div class="listing-icon class-icon" aria-hidden="true">C</div>
                <div class="listing-copy">
                    <span class="listing-type">CLASE · MEDICINA</span>
                    <h2>Anatomía I</h2>
                    <p>Repasa a tu ritmo, por Meet</p>
                </div>
                <div class="listing-price"><strong>S/ 20</strong><span>por hora</span></div>
            </article>
            <div class="community-note"><span aria-hidden="true">+</span> También hay opciones gratuitas</div>
        </div>
    </div>
</section>

<section class="how-section section-space">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Simple, entre estudiantes</p>
            <h2>¿Cómo funciona?</h2>
        </div>
        <div class="steps-grid">
            <article class="step-item">
                <span class="step-number">01</span>
                <h3>Busca</h3>
                <p>Explora materiales y clases ofrecidos por estudiantes de tu comunidad.</p>
            </article>
            <article class="step-item">
                <span class="step-number">02</span>
                <h3>Solicita o reserva</h3>
                <p>Contacta al dueño del material o reserva una clase según lo que necesitas.</p>
            </article>
            <article class="step-item">
                <span class="step-number">03</span>
                <h3>Usa y devuelve / Aprende</h3>
                <p>Comparte materiales con cuidado o aprende junto a un compañero.</p>
            </article>
        </div>
    </div>
</section>

<section class="pillars-section section-space">
    <div class="container">
        <div class="section-heading">
            <p class="eyebrow">Dos formas de avanzar</p>
            <h2>Lo que necesitas, en comunidad</h2>
        </div>
        <div class="pillars-grid">
            <article class="pillar pillar-materials">
                <span class="pillar-label">01 / MATERIALES</span>
                <h3>Comparte lo que te ayuda a aprender.</h3>
                <p>Encuentra instrumental, equipos, libros y calculadoras para alquilar o recibir gratis.</p>
                <span class="pillar-mark" aria-hidden="true">M</span>
            </article>
            <article class="pillar pillar-classes">
                <span class="pillar-label">02 / CLASES</span>
                <h3>Aprende de alguien que ya estuvo ahí.</h3>
                <p>Reserva clases de tus cursos, en línea por Meet o Zoom, con estudiantes tutores.</p>
                <span class="pillar-mark" aria-hidden="true">C</span>
            </article>
        </div>
    </div>
</section>

<section class="solidario-band">
    <div class="container solidario-content">
        <div>
            <p class="eyebrow">Una comunidad que se acompaña</p>
            <h2>UniLink Solidario <span aria-hidden="true">❤️</span></h2>
            <p>Comparte lo que tienes. Ayuda a otro estudiante.</p>
        </div>
        <a class="btn btn-solidario" href="#">Descubre lo gratuito <span aria-hidden="true">→</span></a>
    </div>
</section>
